{
  "version": 8,
  "name": "Winter Demo",
  "metadata": {
    "offline": {
      "sg-topo": {
        "cache-policy": "cache-first",
        "stale-if-error": true
      },
      "sg-bulletins": {
        "cache-policy": "cache-first",
        "stale-if-error": false
      },
      "sg-routes": {
        "cache-policy": "cache-first",
        "stale-if-error": true
      },
      "sg-webcams": {
        "cache-policy": "cache-first",
        "stale-if-error": false
      },
      "sg-sacm5": {
        "cache-policy": "cache-first",
        "stale-if-error": true
      },
      "sg-athm": {
        "cache-policy": "cache-first",
        "stale-if-error": true
      },
      "sg-fallrisk": {
        "cache-policy": "cache-first",
        "stale-if-error": true
      }
    },
    "skitourenguru::groups": {
      "groups": [
        {
          "id": "routes",
          "layers": [
            "routes",
            "routes-risks-case",
            "routes-risks"
          ]
        }
      ]
    },
    "maputnik:renderer": "mlgljs"
  },
  "light": {
    "color": "rgba(255, 219, 0, 1)"
  },
  "projection": {
    "type": "mercator"
  },
  "sources": {
    "sg-topo": {
      "type": "raster",
      "tiles": [
        "https://map.skitourenguru.com/AP_SG_TOPO_MINI_PRIVATE.tms?x={x}&y={y}&z={z}"
      ],
      "minzoom": 0,
      "maxzoom": 24,
      "scheme": "xyz",
      "tileSize": 128,
      "volatile": true
    },
    "sg-bulletins": {
      "type": "geojson",
      "data": "https://www.skitourenguru.com/calc_data2/json/Alps_Bulletins_2025.04.16_EV_4326.json"
    },
    "sg-routes": {
      "type": "vector",
      "tiles": [
        "https://map.skitourenguru.com/Alps_RoutesPlusDerivats.tms?x={x}&y={y}&z={z}"
      ],
      "minzoom": 0,
      "maxzoom": 15,
      "scheme": "xyz",
      "volatile": true
    },
    "sg-routes-risks": {
      "type": "vector",
      "tiles": [
        "https://map.skitourenguru.com/Alps_Segments.tms?x={x}&y={y}&z={z}"
      ],
      "minzoom": 0,
      "maxzoom": 15,
      "scheme": "xyz",
      "volatile": true
    },
    "sg-athm": {
      "type": "raster",
      "tiles": [
        "https://map.skitourenguru.com/AP_SG_ATHM.tms?x={x}&y={y}&z={z}"
      ],
      "minzoom": 0,
      "maxzoom": 24,
      "scheme": "xyz",
      "tileSize": 128,
      "volatile": true
    },
    "sg-sacm5": {
      "type": "raster",
      "tiles": [
        "https://map.skitourenguru.com/AP_SG_SACM5.tms?x={x}&y={y}&z={z}"
      ],
      "minzoom": 0,
      "maxzoom": 24,
      "scheme": "xyz",
      "tileSize": 128,
      "volatile": true
    },
    "sg-symbols": {
      "type": "vector",
      "tiles": [
        "https://map.skitourenguru.com/Alps_Symbols.tms?x={x}&y={y}&z={z}"
      ],
      "minzoom": 0,
      "maxzoom": 24,
      "scheme": "xyz",
      "volatile": true
    },
    "sg-corridors": {
      "type": "raster",
      "tiles": [
        "https://map.skitourenguru.com/AP_SG_CORRIDORS.tms?x={x}&y={y}&z={z}"
      ],
      "minzoom": 0,
      "maxzoom": 24,
      "scheme": "xyz",
      "tileSize": 128,
      "volatile": true
    },
    "sg-fallrisk": {
      "type": "raster",
      "tiles": [
        "https://map.skitourenguru.com/AP_SG_FDRISK.tms?x={x}&y={y}&z={z}"
      ],
      "minzoom": 0,
      "maxzoom": 24,
      "scheme": "xyz",
      "tileSize": 128,
      "volatile": true
    },
    "sg-webcams": {
      "type": "geojson",
      "data": "https://www.skitourenguru.com/calc_data2/json/Alps_Webcams_4326.json"
    },
    "sg-accidents": {
      "type": "geojson",
      "data": "https://www.skitourenguru.com/calc_data2/json/Alps_Accidents_4326.json"
    },
    "sg-huts": {
      "type": "geojson",
      "data": "https://www.skitourenguru.com/calc_data2/json/Alps_Huts_4326.json"
    },
    "sg-poi": {
      "type": "vector",
      "tiles": [
        "https://map.skitourenguru.com/Alps_Pois.tms?x={x}&y={y}&z={z}"
      ],
      "minzoom": 8,
      "maxzoom": 14,
      "scheme": "xyz"
    }
  },
  "sprite": "https://raw.githubusercontent.com/UlysselaGlisse/Style/refs/heads/main/sprites/skitourenguru",
  "glyphs": "https://orangemug.github.io/font-glyphs/glyphs/{fontstack}/{range}.pbf",
  "transition": {
    "duration": 300
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "rgba(255, 255, 255, 1)"
      }
    },
    {
      "id": "topo",
      "type": "raster",
      "source": "sg-topo",
      "layout": {
        "visibility": "visible"
      }
    },
    {
      "id": "overlays",
      "type": "background",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "background-color": "rgba(0, 0, 0, 0)"
      }
    },
    {
      "id": "overlay-slopes",
      "type": "raster",
      "source": "sg-sacm5",
      "minzoom": 13,
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": {
          "stops": [
            [
              13,
              0
            ],
            [
              13.5,
              0.4
            ]
          ]
        }
      }
    },
    {
      "id": "overlay-ATHM",
      "type": "raster",
      "source": "sg-athm",
      "minzoom": 13,
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "raster-opacity": {
          "stops": [
            [
              13,
              0
            ],
            [
              13.5,
              0.4
            ]
          ]
        }
      }
    },
    {
      "id": "overlay-corridors",
      "type": "raster",
      "source": "sg-corridors",
      "minzoom": 13,
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": {
          "stops": [
            [
              13,
              0
            ],
            [
              13.5,
              0.4
            ]
          ]
        }
      }
    },
    {
      "id": "overlay-fallrisk",
      "type": "raster",
      "source": "sg-fallrisk",
      "minzoom": 13,
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": {
          "stops": [
            [
              13,
              0
            ],
            [
              13.5,
              0.4
            ]
          ]
        }
      }
    },
    {
      "id": "routes",
      "type": "line",
      "metadata": {
        "clickable": true
      },
      "source": "sg-routes",
      "source-layer": "Alps_Routes",
      "minzoom": 11,
      "layout": {
        "line-cap": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "rgba(0, 0, 255, 1)",
        "line-opacity": [
          "interpolate",
          [
            "exponential",
            8
          ],
          [
            "zoom"
          ],
          11,
          0,
          11.05,
          1
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.2
          ],
          [
            "zoom"
          ],
          11,
          0,
          11.5,
          3,
          14,
          5.5
        ]
      }
    },
    {
      "id": "routes-risks-cases",
      "type": "line",
      "source": "sg-routes-risks",
      "source-layer": "Alps_Segments_3035",
      "minzoom": 11,
      "maxzoom": 24,
      "filter": [
        "all"
      ],
      "layout": {
        "visibility": "none",
        "line-cap": "square",
        "line-join": "bevel"
      },
      "paint": {
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.2
          ],
          [
            "zoom"
          ],
          11,
          0,
          11.1,
          3,
          14,
          6
        ],
        "line-opacity": 1,
        "line-color": "rgba(0, 0, 0, 1)",
        "line-gap-width": 0,
        "line-blur": 1
      }
    },
    {
      "id": "routes-risks",
      "type": "line",
      "metadata": {
        "clickable": true
      },
      "source": "sg-routes-risks",
      "source-layer": "Alps_Segments_3035",
      "minzoom": 11,
      "maxzoom": 24,
      "filter": [
        "all"
      ],
      "layout": {
        "line-cap": "round",
        "visibility": "none",
        "line-join": "bevel"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "floor",
            [
              "to-number",
              [
                "get",
                "segRisk"
              ]
            ]
          ],
          0,
          "#33CC66",
          1,
          "#FF9933",
          2,
          "#E30613",
          3,
          "#E30613",
          "#444444"
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.2
          ],
          [
            "zoom"
          ],
          11,
          0,
          11.1,
          1,
          14,
          3
        ],
        "line-opacity": [
          "interpolate",
          [
            "exponential",
            8
          ],
          [
            "zoom"
          ],
          11,
          0,
          11.05,
          1
        ]
      }
    },
    {
      "id": "avalanche-bulletins-coldperiode",
      "type": "fill",
      "metadata": {
        "clickable": true
      },
      "source": "sg-bulletins",
      "minzoom": 5,
      "maxzoom": 10,
      "filter": [
        "in",
        "dayper",
        "DAY_PERIODE",
        "COLD_PERIODE"
      ],
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "rdlin"
          ],
          1,
          "#ccff66",
          2,
          "#ffff00",
          3,
          "#ff9900",
          4,
          "#ff0000",
          5,
          "#ff0000",
          "#cccccc"
        ],
        "fill-antialias": false,
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0,
          5.05,
          0.5,
          9.5,
          0.5,
          10,
          0
        ]
      }
    },
    {
      "id": "avalanche-bulletins-hotperiode",
      "type": "fill",
      "metadata": {
        "clickable": true
      },
      "source": "sg-bulletins",
      "minzoom": 5,
      "maxzoom": 10,
      "filter": [
        "==",
        "dayper",
        "HOT_PERIODE"
      ],
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-color": "#000000",
        "fill-antialias": true,
        "fill-opacity": 0.8,
        "fill-pattern": "dot"
      }
    },
    {
      "id": "avalanche-bulletins-outline",
      "type": "line",
      "source": "sg-bulletins",
      "minzoom": 5,
      "maxzoom": 10,
      "filter": [
        "all",
        [
          "in",
          "dayper",
          "DAY_PERIODE",
          "COLD_PERIODE"
        ]
      ],
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "line-opacity": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          5,
          0,
          6,
          0.4,
          10,
          0
        ],
        "line-color": "rgba(0, 0, 0, 1)",
        "line-width": 2
      }
    },
    {
      "id": "poi-accident",
      "type": "symbol",
      "metadata": {
        "clickable": true
      },
      "source": "sg-poi",
      "source-layer": "Alps_Accidents",
      "minzoom": 13,
      "layout": {
        "icon-size": 0.07,
        "icon-allow-overlap": true,
        "icon-ignore-placement": true,
        "visibility": "visible",
        "icon-image": "accident",
        "icon-rotation-alignment": "viewport",
        "icon-rotate": {
          "stops": [
            [
              6,
              0
            ],
            [
              10,
              0
            ]
          ]
        }
      }
    },
    {
      "id": "poi-hut",
      "type": "symbol",
      "metadata": {
        "clickable": true
      },
      "source": "sg-poi",
      "source-layer": "Alps_Huts",
      "minzoom": 13,
      "layout": {
        "icon-image": "hut",
        "visibility": "visible",
        "icon-size": 0.09,
        "icon-allow-overlap": false,
        "icon-overlap": "never",
        "icon-ignore-placement": false,
        "icon-optional": false,
        "text-field": "",
        "text-anchor": "left",
        "text-radial-offset": 1,
        "text-size": 12,
        "text-font": [
          "Open Sans Cond Light",
          "Arial Unicode MS Regular"
        ]
      }
    },
    {
      "id": "poi-webcam",
      "type": "symbol",
      "metadata": {
        "clickable": true
      },
      "source": "sg-poi",
      "source-layer": "WebCams_Huts",
      "minzoom": 13,
      "layout": {
        "icon-image": "webcam",
        "icon-size": 0.05
      }
    }
  ],
  "id": "2s9ycmy",
  "owner": "Ulysse Descamps"
}